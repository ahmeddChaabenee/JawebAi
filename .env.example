# Base Postgres (Supabase : chaine "Session pooler", port 5432)
DATABASE_URL=postgresql://postgres.<ref-projet>:<motdepasse>@<region>.pooler.supabase.com:5432/postgres

# Modele de conversation. Groq, OpenRouter, OpenAI... exposent la meme API :
# seule LLM_BASE_URL change. Groq par defaut.
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Embeddings. Groq n'en fournit pas : la recherche documentaire passe par
# Gemini, appele directement en REST. Cette cle reste necessaire.
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Vector store
PINECONE_API_KEY=
PINECONE_INDEX=gym3

# Recepteur HTTP
PORT=8787

# Verification de signature des webhooks Meta. Le secret de l'app, pas le token
# de page. Laisser vide en developpement desactive la verification -- le
# recepteur refuse alors de demarrer en production.
META_APP_SECRET=
META_VERIFY_TOKEN=
NODE_ENV=development

# Cadence du worker
WORKER_POLL_MS=1000

# Console d administration (obligatoire en production)
ADMIN_TOKEN=

# Tarif du modele, dollars par million de tokens. 0 = cout non calcule.
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0

# Nom de domaine du service (Caddy y obtient le certificat HTTPS)
DOMAIN=assistant.exemple.tn
